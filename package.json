{
  "name": "guardfou",
  "version": "0.1.0",
  "private": true,
  "description": "Extension Firefox et Chrome qui détecte les faux sites marchands (usurpation de marque, domaine trop récent).",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "test": "node --test",
    "lint": "web-ext lint",
    "start": "web-ext run",
    "build": "web-ext build",
    "sign": "web-ext sign --channel=listed --amo-metadata=amo-metadata.json --approval-timeout=0"
  },
  "devDependencies": {
    "web-ext": "^8.3.0"
  },
  "webExt": {
    "ignoreFiles": [
      "tests",
      "graft",
      ".trail",
      "package.json",
      "package-lock.json",
      "amo-metadata.json",
      "store",
      "icons/icon.svg",
      "*.md"
    ],
    "build": {
      "overwriteDest": true,
      "filename": "{name}-{version}.xpi"
    }
  }
}
